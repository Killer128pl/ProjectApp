<Window x:Class="ProjectApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectApp.Desktop"
        mc:Ignorable="d"
        Title="System Obsługi Paczek" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Lista Przesyłek" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Packages}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1" BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr Przesyłki" Binding="{Binding TrackingNumber}" Width="*"/>
                <DataGridTextColumn Header="Nadawca" Binding="{Binding SenderName}" Width="150"/>
                <DataGridTextColumn Header="Waga (kg)" Binding="{Binding Weight}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Płatność" Binding="{Binding PaymentStatus}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Odśwież dane" 
                    Command="{Binding LoadCommand}" 
                    Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>