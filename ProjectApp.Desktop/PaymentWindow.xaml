<Window x:Class="ProjectApp.Desktop.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bramka Płatności v1.0" Height="250" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Przetwarzanie Płatności..." FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <ProgressBar x:Name="PaymentProgress" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Text="Oczekiwanie..." HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,20"/>

            <StackPanel x:Name="ActionButtons" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                <Button Content="Zatwierdź WPŁATĘ" Click="Pay_Click" Width="130" Height="35" Margin="5" Background="#DDFFDD" FontWeight="Bold"/>
                <Button Content="Za pobraniem" Click="COD_Click" Width="130" Height="35" Margin="5" Background="#E6F2FF"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>