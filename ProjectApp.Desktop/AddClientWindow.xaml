<Window x:Class="ProjectApp.Desktop.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy Klient" Height="300" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FAFAFA">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DODAJ KLIENTA" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Imię:"/>
            <TextBox x:Name="FirstNameBox" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Nazwisko:"/>
            <TextBox x:Name="LastNameBox" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Numer Telefonu (tylko cyfry):"/>
            <TextBox x:Name="PhoneBox" Height="25" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Zapisz" Click="Save_Click" Width="100" Height="30" Margin="5" Background="#DDFFDD" FontWeight="Bold"/>
                <Button Content="Anuluj" Click="Cancel_Click" Width="100" Height="30" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>