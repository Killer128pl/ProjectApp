<Window x:Class="ProjectApp.Desktop.ClientsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzanie Klientami" Height="400" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Lista Klientów w Bazie" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" BorderThickness="1" BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Imię" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding PhoneNumber}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="➕ Dodaj Nowego" Click="Add_Click" Padding="10,5" Margin="5" Background="#DDFFDD"/>
            <Button Content="❌ Usuń Zaznaczonego" Click="Delete_Click" Padding="10,5" Margin="5" Background="#FFCCCC" Foreground="DarkRed"/>
            <Button Content="Zamknij" Click="Close_Click" Padding="10,5" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>