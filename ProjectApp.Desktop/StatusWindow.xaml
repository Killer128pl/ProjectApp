<Window x:Class="ProjectApp.Desktop.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz Status" Height="200" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Wybierz nowy status paczki:" FontWeight="Bold" Margin="0,0,0,10"/>

            <ComboBox x:Name="StatusComboBox" Height="30" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Zatwierdź" Click="Accept_Click" Width="80" Height="30" Margin="5" Background="#DDFFDD"/>
                <Button Content="Anuluj" Click="Cancel_Click" Width="80" Height="30" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>